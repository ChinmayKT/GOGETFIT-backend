{
  "name": "gogetfit-backend",
  "version": "1.0.0",
  "description": "GOGETFIT backend API",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test --test-concurrency=1 \"tests/unit/*.test.js\" \"tests/integration/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/*.test.js\"",
    "migrate:inspect": "node migration/scripts/inspect-schema.js",
    "migrate:users": "node migration/scripts/migrate-users.js",
    "migrate:users:apply": "node migration/scripts/migrate-users.js --apply",
    "migrate:user": "node migration/scripts/migrate-single-user.js",
  "migrate:conflicts": "node migration/scripts/resolve-conflict.js",
    "migrate:children": "node migration/scripts/migrate-child-records.js",
    "migrate:validate": "node migration/scripts/validate-migration.js",
    "migrate:users-email": "node migration/scripts/backfill-user-email.js",
    "migrate:users-email-verified": "node migration/scripts/backfill-email-verified.js",
    "migrate:email-into-profile": "node migration/scripts/move-email-into-profile.js",
    "migrate:profile-picture-field": "node migration/scripts/init-profile-picture-field.js",
    "migrate:fitness-profile": "node migration/scripts/backfill-fitness-profile.js",
    "migrate:round-body-fat": "node migration/scripts/round-body-fat.js",
    "migrate:free-diet-plans": "node migration/scripts/migrate-free-diet-plans.js",
    "migrate:gogetfit-plans": "node migration/scripts/migrate-gogetfit-plans.js",
    "migrate:rename-rdee-tdee": "node migration/scripts/rename-rdee-to-tdee.js",
    "provision:admin": "node scripts/provision-admin.js"
  },
  "license": "ISC",
  "dependencies": {
    "argon2": "^0.45.1",
    "dotenv": "^18.0.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.1",
    "mysql2": "^3.24.4"
  },
  "engines": {
    "node": ">=20"
  }
}
